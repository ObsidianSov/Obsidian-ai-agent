.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.log

# Model checkpoints
*.pt
*.pth
*.ckpt

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build
dist/
build/
*.tgz

# Test coverage
.coverage
htmlcov/
.pytest_cache/

